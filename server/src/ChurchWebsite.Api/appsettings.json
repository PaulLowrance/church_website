{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "AudioPath": "uploads/audio",
    "PublicPath": "/uploads/audio",
    "ImagesPath": "uploads/images",
    "ImagesPublicPath": "/uploads/images",
    "TranscriptPath": "uploads/transcripts",
    "TranscriptPublicPath": "/uploads/transcripts"
  },
  "AssemblyAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.assemblyai.com",
    "LlmGatewayUrl": "https://llm-gateway.assemblyai.com",
    "SpeechModels": [ "universal-3-5-pro", "universal-2" ],
    "LlmModel": "gpt-5-mini",
    "SummaryPrompt": "Write a concise, reverent 2-4 sentence summary of this sermon transcript for a church podcast episode description. Reflect the main theme and any key scripture references. Plain prose, no markdown.",
    "MaxSummaryTokens": 500,
    "PollIntervalSeconds": 15
  },
  "Podcast": {
    "MaxAudioBytes": 524288000
  },
  "Speakers": {
    "TitleAbbreviations": {
      "Elder": "Eld",
      "Reverend": "Rev",
      "Pastor": "Pas",
      "Brother": "Bro",
      "Deacon": "Dea"
    }
  },
  "Site": {
    "ChurchName": "Brentwood Hills Primitive Baptist Church"
  }
}
