{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=church_website;Username=church_website;Password=CHANGE_ME"
  },
  "Jwt": {
    "Key": "CHANGE_ME_64_RANDOM_CHARACTERS",
    "Issuer": "ChurchWebsite",
    "Audience": "ChurchWebsiteUsers"
  },
  "Storage": {
    "AudioPath": "/opt/church-website/storage/audio",
    "PublicPath": "/uploads/audio",
    "ImagesPath": "/opt/church-website/storage/images",
    "ImagesPublicPath": "/uploads/images",
    "DefaultCoverImage": "bhpbc-sermon-placeholder.svg",
    "TranscriptPath": "/opt/church-website/storage/transcripts",
    "TranscriptPublicPath": "/uploads/transcripts"
  },
  "AssemblyAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.assemblyai.com",
    "LlmGatewayUrl": "https://llm-gateway.assemblyai.com",
    "SpeechModels": [ "universal-3-5-pro", "universal-2" ],
    "LlmModel": "gpt-5-mini",
    "SummaryPrompt": "Write a concise, reverent 2-4 sentence summary of this sermon transcript for a church podcast episode description. Reflect the main theme and any key scripture references. Plain prose, no markdown.",
    "MaxSummaryTokens": 500,
    "PollIntervalSeconds": 15
  },
  "Podcast": {
    "BaseUrl": "https://dev.bhpbc.org",
    "Title": "Brentwood Hills Primitive Baptist Church Sermons",
    "Description": "Sermons from Brentwood Hills Primitive Baptist Church",
    "Author": "Brentwood Hills Primitive Baptist Church",
    "Category": "Religion & Spirituality",
    "MaxAudioBytes": 524288000
  },
  "Speakers": {
    "TitleAbbreviations": {
      "Elder": "Eld",
      "Reverend": "Rev",
      "Pastor": "Pas",
      "Brother": "Bro",
      "Deacon": "Dea"
    }
  },
  "Site": {
    "ChurchName": "Brentwood Hills Primitive Baptist Church"
  }
}